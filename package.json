{
  "name": "eval-verdict",
  "version": "0.1.0",
  "description": "Turn repeated LLM eval results into one merge-blocking verdict: PASS, FAIL, or ERROR.",
  "type": "module",
  "bin": {
    "eval-verdict": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
